# ============================================================
# 原始素材：一律不入库（体积大 / 二进制 / 可再生）
# ============================================================
*.mp4
*.mkv
*.mov
*.avi
*.zip
*.7z
*.rar
*.tar.gz

# 原始文档（PDF/Office/想定）—— 只入库抽取后的文本
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.scen

# 手机上传的原始照片
*.JPG
*.jpeg
*.png

# ============================================================
# 派生产物：可再生，不入库
# ============================================================
# 关键帧 / 截图（体积大，靠 manifest 重建）
frames/
contact-sheet/
*.npy
*.npz
*.pyc
__pycache__/

# 中间工作区
work/

# 虚拟环境
.venv/
venv/

# ============================================================
# 系统垃圾
# ============================================================
.DS_Store
Thumbs.db
*.swp

# Typst 预览产物
paper/.render/
